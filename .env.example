# Configuración de la base de datos
DATABASE_URL=sqlite:///starwars.db

# Para PostgreSQL (descomenta y configura si usas PostgreSQL)
# DATABASE_URL=postgresql://username:password@localhost/starwars_db

# Clave secreta para Flask Admin
FLASK_APP_KEY=your-secret-key-here

# Puerto de la aplicación
PORT=3000

# Modo debug
FLASK_DEBUG=True